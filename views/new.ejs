<!DOCTYPE html>
<html>
<head>
    <title>Create Chat</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="form-container">

    <h1>Create New Chat</h1>

    <form action="/chats" method="POST">

        <input
            type="text"
            name="from"
            placeholder="From"
            required
        >

        <input
            type="text"
            name="to"
            placeholder="To"
            required
        >

        <textarea
            name="msg"
            rows="5"
            placeholder="Message"
            required
        ></textarea>

        <button>Create Chat</button>

    </form>

</div>

</body>
</html>